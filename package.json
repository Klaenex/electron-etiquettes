{
  "name": "electron-etiquettes",
  "version": "1.0.0",
  "description": "Application d'impression d'étiquettes d'adressage depuis une base Access",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "mdb-reader": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "vite": "^7.1.10",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^11.0.0",
    "tar": "^7.0.0",
    "inflight": "npm:lru-cache@^10.0.0"
  },
  "build": {
    "appId": "com.etiquettes.app",
    "productName": "Étiquettes",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ]
  }
}
